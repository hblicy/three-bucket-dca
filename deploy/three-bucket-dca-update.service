[Unit]
Description=DCA Tracker scheduled update
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/home/ubuntu/three-bucket-dca/three-bucket-dca.env
WorkingDirectory=/home/ubuntu/three-bucket-dca
ExecStart=/bin/bash -lc 'mkdir -p logs && .venv/bin/python scripts/update.py >> logs/update.log 2>&1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
