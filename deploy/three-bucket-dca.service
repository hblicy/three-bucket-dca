[Unit]
Description=DCA Tracker - three-bucket-dca
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/home/ubuntu/three-bucket-dca/three-bucket-dca.env
WorkingDirectory=/home/ubuntu/three-bucket-dca
ExecStart=/home/ubuntu/three-bucket-dca/.venv/bin/python -m uvicorn app:app --host ${DCA_HOST} --port ${DCA_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
